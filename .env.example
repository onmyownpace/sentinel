# Local placeholders only. Copy this file to .env before changing anything.
# These are not production credentials. The password is the same default the
# application uses for a database that listens only on your machine.
# Do not reuse it anywhere else.

# Read by Docker Compose.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# Read by the API. The user, password, host, port, and database name must
# match the POSTGRES_* values above. The +asyncpg suffix selects the async driver.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# Read by the API.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local defaults: full Playwright. Public Render+Neon uses deploy/public.env.example
# (PUBLIC_SHELL=true) instead — do not flip these for everyday local work.
PUBLIC_SHELL=false
LIVE_BROWSER_ENABLED=true
ALLOW_REGISTRATION=true
DATABASE_SSL=false
DATABASE_CONNECT_TIMEOUT_SECONDS=2
SESSION_COOKIE_SAMESITE=lax

# Optional. Seconds one Playwright navigation may take. Must be from 1 to 60.
# The API adds 10 seconds for Chromium to start, then stops the check.
CHECK_NAVIGATION_TIMEOUT_SECONDS=15

# BROW-1 optional viewport screenshots after a check. Files stay on this machine.
SCREENSHOT_ENABLED=true
SCREENSHOT_DIR=backend/data/screenshots
SCREENSHOT_MAX_BYTES=512000
SCREENSHOT_TIMEOUT_MS=5000

# BROW-2 request-bound budget for a whole mini-journey (seconds).
JOURNEY_BUDGET_SECONDS=45

# On-demand failure analysis for stored failed checks.
# ANALYSIS_PROVIDER=simulated (default) uses local heuristics only — no AI network calls.
# ANALYSIS_PROVIDER=openai requires OPENAI_API_KEY and calls the OpenAI API.
ANALYSIS_PROVIDER=simulated
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200

# Read by Docker Compose for the n8n editor port. n8n does not read
# SENTINEL_API_URL. The workflow file stores that address in the "API address"
# node, because n8n blocks workflow access to container environment variables.
N8N_PORT=5678
SENTINEL_API_URL=http://host.docker.internal:8000

# ENG-4 optional containerized API/web (Compose profile `app`):
#   docker compose --profile app up -d --build
# From n8n inside Compose, prefer apiBase http://api:8000 instead of host.docker.internal.
API_PORT=8000
WEB_PORT=3000
# Baked into the web image at build time (browser calls the published API port).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret for n8n scheduled checks (header X-Schedule-Check-Token).
# Put the same value in the scheduled workflow's scheduleToken field.
# Leave empty to refuse scheduled-check POSTs. Not a user account.
SCHEDULE_CHECK_TOKEN=change-me-schedule-token

# Shared secret for n8n GETs against registry/checks/analysis (header X-Automation-Token).
# Put the same value in each workflow's automationToken field.
# Leave empty to require a browser session cookie for those routes.
AUTOMATION_TOKEN=change-me-automation-token

# Cookie session lifetime (days) for email/password sign-in.
SESSION_TTL_DAYS=14

# Dev convenience: create this account on API startup when missing.
# Set SEED_USER_EMAIL empty to skip seeding.
SEED_USER_EMAIL=dev@sentinel.local
SEED_USER_PASSWORD=dev-password-change-me

# Optional. Documented destination for n8n failure-draft delivery.
# Paste the same URL into the workflow webhookUrl field (n8n does not load this).
# Leave empty to keep drafts local-only. Examples: webhook.site, Slack Incoming
# Webhook, Discord webhook URL. Not read by the FastAPI process.
FAILURE_DRAFT_WEBHOOK_URL=

# Optional Mailpit ports (AUTO-3). Only used when Compose profile `mail` is enabled:
#   docker compose --profile mail up -d
# UI http://localhost:8025 — SMTP mailpit:1025 from the n8n container.
# Not read by the FastAPI process. No paid ESP.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

