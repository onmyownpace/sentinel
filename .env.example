# Local placeholders only. Copy this file to .env before changing anything.
# These are not production credentials. The password is the same default the
# application uses for a database that listens only on your machine.
# Do not reuse it anywhere else.

# Read by Docker Compose.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# Read by the API. The user, password, host, port, and database name must
# match the POSTGRES_* values above. The +asyncpg suffix selects the async driver.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# Read by the API.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
