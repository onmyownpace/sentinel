{
  "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb4401",
  "name": "Sentinel incident summary draft",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Sentinel AI-3 incident draft\n\nManual and inactive by default. For each website, POSTs `/api/websites/{id}/incident-drafts` with `X-Automation-Token` (must match `AUTOMATION_TOKEN`). Sentinel builds a simulated (default) incident paragraph from the newest failed checks + any stored analyses.\n\nSet **API address**: `apiBase`, `automationToken`, optional `limit` (1–20), and optional `webhookUrl` (webhook.site / Slack / Discord). Leave `webhookUrl` empty to keep the draft in the n8n execution only.\n\n**Deliver draft** POSTs the API JSON (includes `text` + `paragraph`) only when `webhookUrl` is set. Continues on delivery errors. Does not call OpenAI.",
        "height": 360,
        "width": 520,
        "color": 5
      },
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c7",
      "name": "How this workflow fits",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [160, 0]
    },
    {
      "parameters": {},
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c1",
      "name": "Run incident draft",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 420]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "api-base",
              "name": "apiBase",
              "value": "http://host.docker.internal:8000",
              "type": "string"
            },
            {
              "id": "automation-token",
              "name": "automationToken",
              "value": "change-me-automation-token",
              "type": "string"
            },
            {
              "id": "failed-limit",
              "name": "limit",
              "value": "5",
              "type": "string"
            },
            {
              "id": "webhook-url",
              "name": "webhookUrl",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c2",
      "name": "API address",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.apiBase }}/api/websites",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $json.automationToken }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c3",
      "name": "List websites",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('API address').first().json.apiBase }}/api/websites/{{ $json.id }}/incident-drafts?limit={{ $('API address').first().json.limit }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $('API address').first().json.automationToken }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "onError": "continueRegularOutput"
      },
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c4",
      "name": "Request incident draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-paragraph",
              "leftValue": "={{ $json.paragraph }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c5",
      "name": "Draft ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1220, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "webhook-present",
              "leftValue": "={{ $('API address').first().json.webhookUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c6",
      "name": "Webhook configured",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1460, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('API address').first().json.webhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a13c0001-ai3d-4f6a-8b3c-11aa22bb44c8",
      "name": "Deliver draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 300],
      "onError": "continueRegularOutput"
    }
  ],
