{
  "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc4401",
  "name": "Sentinel scheduled website checks",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Sentinel scheduled checks\n\nInactive by default. When activated, this workflow runs every 6 hours, lists websites with `monitoring_enabled=true`, and POSTs each one to `/scheduled-checks` with `X-Schedule-Check-Token`.\n\nAfter each check it GETs `/monitoring-state` (automation token). AUTO-2 uses `should_notify_fail` / `should_notify_latency` / `should_notify_recover` (MON-2 signals gated by per-site rules stored in Sentinel).\n\nSet **API address**: `apiBase`, `scheduleToken`, `automationToken`, and optional `webhookUrl` (webhook.site / Slack Incoming Webhook / Discord — no paid email).\n\n**Deliver draft** runs only when `webhookUrl` is non-empty and continues on delivery errors.\n\nThe workflow does not call an external AI API.",
        "height": 420,
        "width": 520,
        "color": 5
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44c7",
      "name": "How this workflow fits",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [160, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44c1",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 420]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "api-base",
              "name": "apiBase",
              "value": "http://host.docker.internal:8000",
              "type": "string"
            },
            {
              "id": "schedule-token",
              "name": "scheduleToken",
              "value": "change-me-schedule-token",
              "type": "string"
            },
            {
              "id": "automation-token",
              "name": "automationToken",
              "value": "change-me-automation-token",
              "type": "string"
            },
            {
              "id": "webhook-url",
              "name": "webhookUrl",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44c2",
      "name": "API address",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.apiBase }}/api/websites?monitoring=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $json.automationToken }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44c3",
      "name": "List enrolled websites",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('API address').first().json.apiBase }}/api/websites/{{ $json.id }}/scheduled-checks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Schedule-Check-Token",
              "value": "={{ $('API address').first().json.scheduleToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44c4",
      "name": "Run scheduled check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('API address').first().json.apiBase }}/api/websites/{{ $('List enrolled websites').item.json.id }}/monitoring-state",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $('API address').first().json.automationToken }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44d0",
      "name": "Read monitoring state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "should-notify-fail",
              "leftValue": "={{ $json.should_notify_fail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44c5",
      "name": "Notify on fail",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "should-notify-latency",
              "leftValue": "={{ $json.should_notify_latency }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44d3",
      "name": "Notify on latency",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1440, 500]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "should-notify-recover",
              "leftValue": "={{ $json.should_notify_recover }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8d3b0c21-2e5f-4a7b-9c4d-22bb33cc44d1",
      "name": "Notify on recover",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1440, 700]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "website-name",
              "name": "website_name",
              "value": "={{ $('List enrolled websites').item.json.name }}",
              "type": "string"
            },
            {
              "id": "base-url",
              "name": "base_url",
              "value": "={{ $('List enrolled websites').item.json.base_url }}",
              "type": "string"
            },
            {
              "id": "rule",
              "name": "rule",
              "value": "on_fail",
              "type": "string"
            },
            {
              "id": "latest-outcome",
              "name": "latest_outcome",
              "value": "={{ $json.latest_outcome }}",
              "type": "string"
            },
            {
              "id": "latest-http-status",
              "name": "latest_http_status",
              "value": "={{ $json.latest_http_status }}",
              "type": "number"
            },
            {
