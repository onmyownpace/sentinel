# Public shell (Render + Neon) — copy values into Render env / Neon URL.
# Do NOT use this file for local Compose development (.env stays local).
# $0 path: no OpenAI, no live Chromium, n8n stays on your machine.

PUBLIC_SHELL=true
LIVE_BROWSER_ENABLED=false
ALLOW_REGISTRATION=false
ENVIRONMENT=production
ANALYSIS_PROVIDER=simulated
OPENAI_API_KEY=

# Neon: use the pooled or direct URI, rewrite scheme for asyncpg, keep SSL on.
# Example shape only — paste your real secret in the host dashboard, never in git:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb
DATABASE_SSL=true
DATABASE_CONNECT_TIMEOUT_SECONDS=15

# Exact frontend origin(s) for CORS + cookies
CORS_ORIGINS=https://sentinel.mindfold.fyi
SESSION_COOKIE_SAMESITE=none
SESSION_TTL_DAYS=14

# Strong unique values — not the local defaults
SEED_USER_EMAIL=demo@your-domain.example
SEED_USER_PASSWORD=replace-with-long-unique-secret
AUTOMATION_TOKEN=
SCHEDULE_CHECK_TOKEN=

SCREENSHOT_ENABLED=false
CHECK_NAVIGATION_TIMEOUT_SECONDS=15
JOURNEY_BUDGET_SECONDS=45
