# Public shell (Render + Neon) — copy values into Render env / Neon URL.
# Do NOT use this file for local Compose development (.env stays local).
# Hosted path: no live Chromium, closed registration.
# Signed-in workspace may use Together (OpenAI-compatible) when keys are set.
# Seeded portfolio/demo checks stay simulated and never call paid AI.

PUBLIC_SHELL=true
LIVE_BROWSER_ENABLED=false
ALLOW_REGISTRATION=false
ENVIRONMENT=production

# --- Analysis (signed-in workspace) ---
# Names only — paste secret values in the Render dashboard, never in git.
# ANALYSIS_PROVIDER=simulated   # portfolio-only / no paid AI
# For Together on signed-in Analyze / patterns / drafts:
ANALYSIS_PROVIDER=openai
OPENAI_BASE_URL=https://api.together.ai/v1
OPENAI_API_KEY=
TOGETHER_API_KEY=
OPENAI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
# Prefer OPENAI_API_KEY for the Together key. TOGETHER_API_KEY is a fallback
# alias used only when OPENAI_API_KEY is empty.

# Neon: use the pooled or direct URI, rewrite scheme for asyncpg, keep SSL on.
# Example shape only — paste your real secret in the host dashboard, never in git:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb
DATABASE_SSL=true
DATABASE_CONNECT_TIMEOUT_SECONDS=15

# Exact frontend origin(s) for CORS + cookies
CORS_ORIGINS=https://sentinel.mindfold.fyi
SESSION_COOKIE_SAMESITE=none
SESSION_TTL_DAYS=14

# Strong unique values — not the local defaults
SEED_USER_EMAIL=demo@your-domain.example
SEED_USER_PASSWORD=replace-with-long-unique-secret
AUTOMATION_TOKEN=
SCHEDULE_CHECK_TOKEN=

SCREENSHOT_ENABLED=false
CHECK_NAVIGATION_TIMEOUT_SECONDS=15
JOURNEY_BUDGET_SECONDS=45
